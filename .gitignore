# ==============================================
# Environment Variables & Secrets (CRITICAL)
# ==============================================
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
# Explicitly keep documentation templates tracked
!**/.env.example
!.env.example

# ==============================================
# Dependencies (DO NOT IGNORE LOCKFILES)
# ==============================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
jspm_packages/

# ==============================================
# Build & Distribution Artifacts
# ==============================================
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
.next/
.nuxt/
.out/
.storybook-out/

# ==============================================
# Cache & Temporary Workspaces
# ==============================================
.cache/
.parcel-cache/
.npm/
.eslintcache/
.turbo/
tmp/
temp/
uploads/
**/uploads/
public/uploads/

# ==============================================
# AI Tooling & IDE Caches
# ==============================================
# Keep .kiro/skills, .kiro/specs, .kiro/steering tracked.
# Ignore IDE state, logs, and indexing caches:
.kiro/**/cache/
.kiro/**/*.log
.cursor/cache/
.cursor/logs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ==============================================
# Logs & Runtime Data
# ==============================================
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# ==============================================
# Testing & Coverage
# ==============================================
coverage/
*.lcov
.nyc_output
test-results/

# ==============================================
# Databases & Dumps
# ==============================================
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.sql.backup
*.backup
*.bak

# ==============================================
# Operating System Junk
# ==============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ==============================================
# Docker Overrides
# ==============================================
docker-compose.override.yml

# Environment Templates
*.env.example
**/*.env.example
